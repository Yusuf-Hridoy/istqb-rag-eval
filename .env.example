GROQ_API_KEY=
ANSWER_MODEL=openai/gpt-oss-120b
EMBED_MODEL=BAAI/bge-small-en-v1.5
TOP_K=4
MIN_RELEVANCE=0.3
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
SYLLABUS_PATH=data/raw/ctfl_syllabus_v4.pdf
FIRST_CONTENT_PAGE=
LAST_CONTENT_PAGE=63
CHROMA_DIR=.chroma
COLLECTION_NAME=ctfl_v4
JUDGE_MODEL=qwen/qwen3.8-27b
# Caps each judge reply. Groq sizes a request from max_tokens, so a high
# value is rejected outright on the free tier's 1000 output-tokens/minute.
JUDGE_MAX_TOKENS=950
# page = the Phase 2 baseline chunking; section = one chunk per syllabus section
CHUNKING=page
# structured = the model reports its own status and cited pages (Phase 4 default).
# Set to text to reproduce runs/pilot-1 and the other text-mode runs.
ANSWER_FORMAT=structured
